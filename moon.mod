name = "ggbond44439/moonloom"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/ggbond44439/moonloom"

license = "Apache-2.0"

keywords = [
  "multiformats",
  "multibase",
  "multicodec",
  "multihash",
  "cid",
  "multiaddr",
]

preferred_target = "wasm"

description = "MoonLoom is a self-describing content-addressing toolkit for MoonBit."

import {
  "moonbitstack/mooncrypt@0.2.2",
}
