name = "ggbond44439/moonloom"

version = "0.1.2"

readme = "README.md"

repository = "https://github.com/ggbond44439/moonloom"

license = "Apache-2.0"

keywords = [
  "multiformats",
  "moonbase",
  "multibase",
  "multicodec",
  "multihash",
  "cid",
  "multiaddr",
]

preferred_target = "wasm"

description = "MoonLoom is a MoonBit self-describing content-addressing layer built on Moonbase."

import {
  "moonbitstack/mooncrypt@0.2.2",
  "moonbitstack/moonbase@0.4.0",
}
